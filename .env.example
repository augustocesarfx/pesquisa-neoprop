# Banco Postgres da pesquisa (obrigatório)
DATABASE_URL="postgresql://usuario:senha@host:5432/pesquisa_neoprop"

# URL pública do site (usada no card de compartilhamento)
APP_URL="https://pesquisa.neoprop.com.br"

# Token para exportar as respostas em /api/export (gere um valor longo e aleatório)
EXPORT_TOKEN=""

# Vídeo da abertura — troque quando o arquivo final estiver pronto
# html5 = URL do .mp4 | youtube/vimeo = ID | embed = URL completa do iframe
NEXT_PUBLIC_SURVEY_VIDEO_PROVIDER="html5"
NEXT_PUBLIC_SURVEY_VIDEO_SRC=""
NEXT_PUBLIC_SURVEY_VIDEO_POSTER=""

# Destino do botão "Voltar para a Neoprop" na tela final
NEXT_PUBLIC_SURVEY_BACK_URL="https://neoprop.com.br"
