# Planilha do Google onde as respostas são gravadas (obrigatório)
# URL do Web App publicado a partir de scripts/apps-script/Codigo.gs
SHEETS_WEBHOOK_URL=""
# Mesmo valor da constante TOKEN dentro do Apps Script (longo e aleatório)
SHEETS_TOKEN=""

# Senha do painel de análise em /painel (mínimo 8 caracteres).
# Sem ela o painel fica FECHADO — nunca aberto sem senha.
PANEL_PASSWORD=""

# URL pública do site (usada no card de compartilhamento)
APP_URL="https://pesquisa.neoprop.com.br"

# Vídeo da abertura
# vturb (padrão) = player VTurb/ConverteAI, configurado nas variáveis abaixo
# html5 = URL do .mp4 | youtube/vimeo = ID | embed = URL completa do iframe
NEXT_PUBLIC_SURVEY_VIDEO_PROVIDER="vturb"
NEXT_PUBLIC_SURVEY_VIDEO_SRC=""
NEXT_PUBLIC_SURVEY_VIDEO_POSTER=""

# Player VTurb — os dois IDs vêm do snippet de instalação do painel.
# O delay (135 s) que libera a seção final fica em src/config/survey.ts
NEXT_PUBLIC_VTURB_PLAYER_ID="6a8c376a48dab67a9e6535c4"
NEXT_PUBLIC_VTURB_ACCOUNT_ID="bd3b9d3d-2a97-4054-bee1-41e5b412ae44"

# Destino do botão "Voltar para a Neoprop" na tela final
NEXT_PUBLIC_SURVEY_BACK_URL="https://neoprop.com.br"
